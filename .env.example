# =====================================================================
# TIMELENS — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy these variables into backend/.env and frontend/.env as needed.
# Do NOT commit real credentials or production secrets to version control.
# =====================================================================

# --- FRONTEND (frontend/.env) ---
# Leave blank in production unified builds (automatically uses /api),
# or set to your deployed backend URL (e.g. https://your-api-domain.com/api).
# For local development, defaults to http://localhost:5000/api.
VITE_API_BASE_URL=

# --- BACKEND (backend/.env) ---
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/timelens
JWT_SECRET=replace_with_a_secure_random_64_char_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173
DB_SSL=false
